{
  "name": "pi-queue-steer-factory",
  "version": "0.17.2",
  "description": "Visible steering, follow-up, and session-control queues for Pi and Pi Fabric.",
  "type": "module",
  "license": "MIT",
  "author": "Thomas Mustier",
  "keywords": [
    "pi-package",
    "pi-extension",
    "queue",
    "factory",
    "pi-fabric",
    "orchestration",
    "steering",
    "follow-up",
    "tui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monotykamary/pi-queue-steer-factory.git"
  },
  "bugs": "https://github.com/monotykamary/pi-queue-steer-factory/issues",
  "homepage": "https://github.com/monotykamary/pi-queue-steer-factory",
  "files": [
    "index.ts",
    "conversation-queue-bridge.ts",
    "timeline-render.ts",
    "editor-render.ts",
    "fabric-peers.ts",
    "fabric-prewalk.ts",
    "queue-state.ts",
    "queued-input.ts",
    "queue-persistence.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/validation.md",
    "assets/pi-queue-steer-demo.gif",
    "headless.ts",
    "protocol.ts",
    "queue-policy.ts",
    "rpc-bridge.ts",
    "control-bridge.ts",
    "docs/headless.md",
    "dist"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "ci": "npm run check && npm test",
    "build": "tsc -p tsconfig.headless.json",
    "prepack": "npm run build",
    "pretest": "npm run build"
  },
  "pi": {
    "extensions": [
      "index.ts"
    ],
    "image": "https://raw.githubusercontent.com/monotykamary/pi-queue-steer-factory/main/assets/pi-queue-steer-demo.gif"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "24.12.4",
    "tsx": "4.22.1",
    "typescript": "5.9.3"
  },
  "exports": {
    ".": "./index.ts",
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js",
      "default": "./dist/headless.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js",
      "default": "./dist/protocol.js"
    },
    "./rpc": {
      "types": "./dist/rpc-bridge.d.ts",
      "import": "./dist/rpc-bridge.js",
      "default": "./dist/rpc-bridge.js"
    },
    "./control": {
      "types": "./dist/control-bridge.d.ts",
      "import": "./dist/control-bridge.js",
      "default": "./dist/control-bridge.js"
    },
    "./*.ts": "./*.ts"
  }
}
